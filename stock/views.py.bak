from datetime import date
from django.contrib.auth.decorators import login_required
from django.db.models import Sum
from django.shortcuts import render
from .models import Product, Sale, SaleItem, Purchase, Expense, Customer, Supplier

@login_required
def dashboard(request):
    today = date.today()
    products = Product.objects.filter(active=True)
    low_stock = products.filter(stock__lte=__import__('django.db.models', fromlist=['F']).F('minimum_stock')).order_by('stock')[:10]
    sales_today = Sale.objects.filter(sold_at=today).aggregate(total=Sum('total'))['total'] or 0
    sales_month = Sale.objects.filter(sold_at__year=today.year, sold_at__month=today.month).aggregate(total=Sum('total'))['total'] or 0
    expenses_month = Expense.objects.filter(date__year=today.year, date__month=today.month).aggregate(total=Sum('amount'))['total'] or 0
    stock_value = sum((p.stock * p.cost_price for p in products), 0)
    return render(request, "stock/dashboard.html", {
        "today": today, "product_count": products.count(), "low_stock": low_stock,
        "sales_today": sales_today, "sales_month": sales_month, "expenses_month": expenses_month,
        "stock_value": stock_value, "sale_count": Sale.objects.count(),
        "purchase_count": Purchase.objects.count(), "customer_count": Customer.objects.count(),
        "supplier_count": Supplier.objects.count(),
    })
